@article{ivanusch2026priority,
  abbr={Under Review},
  title={When do parliaments communicate priorities? Public opinion, problem pressure and legislative power in 26 democracies},
  author={Ivanusch, Christoph and Goetz, Klaus H and R{\"o}th, Leonce},
  year={2026},
  note={Available upon request},
  selected={false},
  abstract={Parliaments are central to the articulation of political priorities in democracies. Yet, prior research has largely overlooked their role in the process of prioritization. In this article, we address this gap by asking to what extent and when parliaments communicate priorities. We revisit the concept of political priorities; discuss the role of parliaments in the expression of priorities; and identify key factors that affect when parliaments communicate priorities. Empirically, we apply state-of-the-art natural language processing to provide a novel measure of priority communication in migration-related speeches delivered in 26 national parliaments between 2009 and 2024 (N = 82,861,329 sentences). The results show that parliamentary priority communication responds to both public priorities and problem pressure. Moreover, parliaments that wield greater legislative power express priorities more often and show heightened responsiveness to problem pressure. Our study provides important comparative evidence on how parliaments fulfil their articulation function through the communication of priorities.},
}

@article{roth2026priority,
  abbr={Under Review},
  title={Priority setting through public communication: How do aligned priorities emerge in the European Union?},
  author={R{\"o}th, Leonce and Ivanusch, Christoph and Goetz, Klaus H},
  year={2026},
  note={Available upon request},
  selected={false},
  abstract={Political decision making requires agreement on priorities, i.e. what is important and urgent. Where priorities cannot be authoritatively imposed, public communication plays a crucial role in achieving priority alignment as part of agenda setting. Building on agenda-setting literature, we examine (i) how European Union (EU) institutions engage in priority setting through public communication in migration and asylum policy; and (ii) how they influence one another in this process. For our analysis, we draw on a full corpus of European Commission and European Parliament speeches and European Council conclusions from 2000 to 2024. Using transformer-based classification models, we identify priority communication through calls for urgent action on migration and asylum. Vector autoregression models trace lead-lag dynamics in priority communication. From 2009 onward, the Commission and the European Parliament emerged as priority setters in non-crisis times; the European Council dominated during the 2015/16 crisis. The three institutions mutually reinforced each other’s priority communication, resulting in high alignment of priorities.},
}

@article{dornbusch2026politicising,
  abbr={Under Review},
  title={Politicising regulatory responses to time pressure: A mixed-methods analysis of national parliamentary debates on pharmaceutical regulation in the EU},
  author={Dornbusch, Paula and Ivanusch, Christoph},
  year={2026},
  note={Available upon request},
  selected={false},
  abstract={Access to pharmaceuticals depends on regulation that decides when medicines are deemed safe and effective. This process faces considerable time pressure, which can peak when urgency is high (e.g., during a health crisis) or when licensing decisions take longer (e.g., due to increasing complexity). Pharmaceutical regulation is a technical decision with considerable political implications, so that research on the politics of pharmaceuticals must account for regulatory innovation. We investigate politicising effects of regulatory responses to time pressure at the European Medicines Agency, particularly the Adaptive Pathways Pilot (2014-2016) and the COVID-19 acceleration initiatives (2021-2023). We conduct state-of-the-art quantitative and qualitative text analysis of parliamentary debates in Ireland and Germany (2009-2024/25) to assess whether and how pharmaceuticals are discussed in national parliaments. Through a lens of temporal delinking, we assess the politicisation of substance, institutional-organisational setting, and procedures of pharmaceutical regulation in two critical time periods. We find that the EMA effectively contains time pressure emerging from slower licensing decisions, as the Adaptive Pathways pilot (2014-2016) was not politicised. The urgency of COVID-19, on the other hand, shows considerable politicisation. This politicising effect of time pressure adds to a literature in which time pressure is rather seen as a de-politicising force.}
}

@article{dollbaum2026combining,
  abbr = {Under Review},
  title={The domain-enriched model: Integrating existing models and domain-specific data to enhance political text classification},
  author={Dollbaum, Jan Matti and Ivanusch, Christoph and Goedeking, Jan and Klochko, Polina and Kononchuk, Svitlana},
  year={2026},
  note={Available upon request},
  selected={false},
  abstract={We present a novel approach for political text classification specifically suited for less researched environments and cross-lingual/cross-context adaptation. Our approach combines BERT-based models fine-tuned on existing large-scale data with domain-specific enrichment. This method addresses key limitations of existing approaches: models trained solely on existing large-scale datasets often struggle to generalize beyond their training domains and contexts, while creating sufficient domain-specific training data remains time and resource-intensive. We demonstrate our approach using annotated parliamentary speech data from Poland and Ukraine. We leverage ManifestoBERTa and further fine-tune it on domain-specific examples. This approach outperforms both the off-the-shelf cross-domain ManifestoBERTa and a within-domain XLM-RoBERTa-large model fine-tuned exclusively on domain-specific data. The performance gains are particularly strong with few training data. We also document strengths and limitations of applying the model across languages and political environments. Our domain-enriched approach is particularly valuable for under-researched political contexts and low-budget research projects.},
}

@article{koch2026offtopic,
  abbr = {Work-in-Progress},
  title={How parties navigate unfavorable issue agendas},
  author={Koch, Elias and Ivanusch, Christoph},
  year={2026},
  note={Available upon request},
  selected={false},
  abstract={How do political parties navigate unfavorable issue agendas? Central arenas of party competition are structured around a substantive scope, and parties are frequently confronted with agenda issues offering them only limited competitive advantage. We argue that parties strategically \textit{go off-topic} by diverting from unattractive agenda issues to pivot towards more attractive matters. We test this argument, tracing shifts in partisan issue attention in the German \textit{Bundestag} (2009–2021) and the Austrian \textit{Nationalrat} (1996–2019), combining legislative bills, speeches, and party manifestos classified with fine-tuned transformer models. Following GLM and Difference-in-Differences approaches, we show that parties are more likely to go off-topic when the agenda is dominated by issues they neither own nor prioritize programmatically. Consistent with conventional issue competition theory, they then pivot towards more advantageous issues. Hence, parties compete not only by emphasizing preferred issues, but also by systematically diverting attention away from unfavorable issue agendas in day-to-day politics.},
}
